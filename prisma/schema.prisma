// Schéma Prisma — Plateforme CINOVA
// Challenge national de l'innovation agropastorale et numérique (RECA — « Le Dernier Kilomètre »)
//
// Ce schéma est volontairement posé dès l'Étape 1 pour cadrer l'architecture,
// même si les fonctionnalités seront construites progressivement (compte -> équipe -> ... -> jury).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
//  Énumérations
// ─────────────────────────────────────────────────────────────

enum UserRole {
  CANDIDATE // Candidat / chef d'équipe
  AUDITOR // Consultation en lecture seule
  ADMIN // Comité technique / RECA
  JURY // Membre du jury
  REGIONAL_RELAY // Relais Chambre Régionale d'Agriculture (CRA)
}

enum Gender {
  FEMALE
  MALE
  UNDISCLOSED
}

// Les 8 régions du Niger (+ diaspora éventuelle plus tard)
enum NigerRegion {
  AGADEZ
  DIFFA
  DOSSO
  MARADI
  NIAMEY
  TAHOUA
  TILLABERI
  ZINDER
}

// Deux pistes de participation (note conceptuelle §)
enum ParticipationTrack {
  CREATION // Conception d'un prototype pendant l'événement
  ADAPTATION // Ajustement d'une solution existante
}

// Cycle de vie d'une candidature (équipe)
enum ApplicationStatus {
  DRAFT // En cours de rédaction
  SUBMITTED // Déposée
  UNDER_REVIEW // En cours d'examen (comité technique)
  PRESELECTED // Présélectionnée (bootcamp)
  REJECTED // Non retenue
  FINALIST // Finaliste (hackathon)
  WINNER // Lauréate
}

// Rôle d'un membre au sein de l'équipe
enum TeamMemberRole {
  LEAD // Chef d'équipe
  DEVELOPER
  DESIGNER
  DATA
  AGRONOMIST // Agronome / conseiller agricole
  BUSINESS // Gestion / commercial
  OTHER
}

// Collège du jury (délibèrent conjointement ; les producteurs ont un veto d'utilisabilité)
enum JuryCollege {
  TECHNICAL // Collège technique
  PRODUCERS // Collège des producteurs
}

// ─────────────────────────────────────────────────────────────
//  Modèles Auth.js (NextAuth v5)  — requis par @auth/prisma-adapter
// ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // Auth par email + mot de passe (bcrypt)

  isActive     Boolean      @default(true)
  role         UserRole     @default(CANDIDATE)
  gender       Gender?
  region       NigerRegion?
  phone        String?
  organization String? // Structure / entreprise / établissement
  locale       String       @default("fr")

  // Collège du jury si role = JURY
  juryCollege JuryCollege?

  accounts Account[]
  sessions Session[]

  // Équipe dont l'utilisateur est chef (candidat)
  ledTeams Team[] @relation("TeamLeader")

  // Évaluations réalisées en tant que membre du jury
  evaluations Evaluation[] @relation("JuryEvaluations")

  // Équipes affectées à ce juré (évaluation autonome)
  assignments Assignment[] @relation("JuryAssignments")

  // Relais CRA : région rattachée si role = REGIONAL_RELAY
  relayRegion NigerRegion?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────
//  Domaine métier CINOVA
// ─────────────────────────────────────────────────────────────

// Une édition du challenge (permet de rejouer l'événement chaque année)
model Edition {
  id        String   @id @default(cuid())
  name      String // ex. « CINOVA 2026 — Le Dernier Kilomètre »
  year      Int
  isActive  Boolean  @default(false)
  // Fenêtre de l'appel à candidatures
  applicationsOpenAt  DateTime?
  applicationsCloseAt DateTime?
  // Publication des résultats (délibération finale, un seul tour)
  resultsPublishedAt  DateTime?

  challenges Challenge[]
  teams      Team[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Un défi retenu par le comité technique (max 3 par édition)
model Challenge {
  id          String  @id @default(cuid())
  editionId   String
  code        String // ex. « ALERTE », « MARCHE »
  title       String
  summary     String? // Résumé court
  description String? @db.Text
  isActive    Boolean @default(true)
  order       Int     @default(0)

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  teams   Team[]

  @@unique([editionId, code])
}

// Une candidature = une équipe
model Team {
  id          String             @id @default(cuid())
  name        String
  // Informations du projet (étape 3)
  description   String? @db.Text // Description détaillée
  problem       String? @db.Text // Problème traité
  solution      String? @db.Text // Solution proposée
  beneficiaries String? @db.Text // Bénéficiaires visés (liste de clés, séparées par des virgules)

  // Section complémentaire
  heardAbout String? // Comment avez-vous entendu parler du challenge
  motivation String? @db.Text // Que recherchez-vous en participant
  otherInfo  String? @db.Text // Autre information pertinente

  track       ParticipationTrack @default(CREATION)
  status      ApplicationStatus  @default(DRAFT)
  region      NigerRegion? // Région de rattachement de l'équipe (quota régional)

  // Besoin d'un développeur au sein de l'équipe (étape 2)
  needsDeveloper Boolean @default(false)
  // Acceptation du règlement au moment du dépôt
  acceptedRules  Boolean @default(false)

  leaderId    String
  leader      User               @relation("TeamLeader", fields: [leaderId], references: [id])

  editionId   String?
  edition     Edition?           @relation(fields: [editionId], references: [id])

  challengeId String?
  challenge   Challenge?         @relation(fields: [challengeId], references: [id])

  members     TeamMember[]
  attachments Attachment[]
  evaluations Evaluation[]
  assignments Assignment[]

  // Revue par le comité technique (admin)
  reviewNote String?   @db.Text // Retour motivé
  reviewedAt DateTime?

  submittedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status])
  @@index([region])
}

// Pièce jointe d'un projet (capture d'écran, visuel pertinent). Stockée en base.
model Attachment {
  id        String   @id @default(cuid())
  teamId    String
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

// Un membre de l'équipe (renseigné par le chef d'équipe ; pas forcément un compte)
model TeamMember {
  id       String         @id @default(cuid())
  teamId   String
  fullName String
  email    String?
  phone    String?
  gender   Gender?
  region   NigerRegion?
  role     TeamMemberRole @default(OTHER)
  isLeader Boolean        @default(false)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([teamId])
}

// Paramètres de la plateforme (clé/valeur) — ex. configuration SMTP éditable depuis l'admin
model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// Suivi des visites (analytics léger et respectueux de la vie privée).
model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  country   String? // code pays (header CDN : cf-ipcountry / x-vercel-ip-country)
  sessionId String? // cookie anonyme
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([country])
  @@index([sessionId])
}

// Journal d'audit — trace des actions clés (append-only, résilient aux suppressions).
model AuditLog {
  id         String   @id @default(cuid())
  action     String // REGISTER, LOGIN, SUBMIT, STATUS_CHANGE, ATTACHMENT
  actorEmail String?
  actorRole  String?
  targetType String? // TEAM, USER
  targetId   String?
  message    String?  @db.Text
  meta       String?  @db.Text // JSON
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

// ─────────────────────── Notation du jury ───────────────────────

// Critère de la grille d'évaluation (défini par le comité technique).
model Criterion {
  id          String      @id @default(cuid())
  code        String       @unique
  label       String
  description String?      @db.Text
  college     JuryCollege? // (déprécié) — jury unique, grille commune
  weight      Int          @default(0) // pondération en %
  maxScore    Int         @default(5)
  order       Int         @default(0)
  isActive    Boolean     @default(true)

  scores Score[]
}

// Évaluation d'une équipe par un membre du jury.
model Evaluation {
  id        String       @id @default(cuid())
  teamId    String
  juryId    String
  college   JuryCollege? // (déprécié) — jury unique
  comment   String?      @db.Text
  usable    Boolean? // veto d'utilisabilité (ouvert à tout juré)
  submitted Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  jury   User   @relation("JuryEvaluations", fields: [juryId], references: [id], onDelete: Cascade)
  scores Score[]

  @@unique([teamId, juryId])
  @@index([teamId])
}

// Affectation d'une équipe à un juré (évaluation autonome, un seul niveau).
// Si une équipe a ≥1 affectation, seuls les jurés affectés l'évaluent ; sinon, tous.
model Assignment {
  id        String   @id @default(cuid())
  teamId    String
  juryId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  jury User @relation("JuryAssignments", fields: [juryId], references: [id], onDelete: Cascade)

  @@unique([teamId, juryId])
  @@index([juryId])
  @@index([teamId])
}

// Note d'un critère au sein d'une évaluation.
model Score {
  id           String @id @default(cuid())
  evaluationId String
  criterionId  String
  value        Int

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion  Criterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, criterionId])
}
