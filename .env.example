# Copiez ce fichier en .env puis ajustez les valeurs.

# --- Base de données ---
# Postgres local. Encodez les caractères spéciaux du mot de passe (ex. & -> %26).
DATABASE_URL="postgresql://postgres:motdepasse@localhost:5432/db_cinova?schema=public"
# (Alternative : cluster dédié du projet via `npm run db:start` -> port 5544)

# --- Auth.js (NextAuth v5) ---
AUTH_SECRET="remplacez-moi"           # npx auth secret
AUTH_URL="http://localhost:3000"

# --- Application ---
NEXT_PUBLIC_APP_NAME="CINOVA"
NEXT_PUBLIC_DEFAULT_LOCALE="fr"

# --- Email (repli ; la config principale se fait dans Paramètres admin) ---
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="CINOVA <no-reply@cinova.ne>"
